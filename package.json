{
  "name": "solari-gauntlet",
  "version": "0.1.0",
  "description": "AI code-review agent: clones any GitHub repo into a Solari sandbox, figures out how to run it, probes it with a Solari cloud browser, and writes a scored review.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "smoke": "tsx src/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@solarisdk/browser": "^0.1.3",
    "@solarisdk/sdk": "^0.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
